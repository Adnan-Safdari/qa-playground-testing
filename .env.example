# Copy to .env and fill in. .env is git-ignored — never commit real tokens.
# Read by the Streamlit dashboard (dashboard/) and the Selenium suite (testing/).

# GitHub fine-grained token, repo Adnan-Safdari/qa-playground-testing,
# permission "Actions: Read and write" (sync results + trigger CI runs).
GITHUB_TOKEN=
GITHUB_REPOSITORY=Adnan-Safdari/qa-playground-testing

# App under test
BASE_URL=http://localhost:3000

# Selenium: 1 = headless, 0 = watch the browser
HEADLESS=1
